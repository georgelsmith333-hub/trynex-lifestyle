# ==================== COPY THIS TO production.env ====================

GITHUB_TOKEN=your_github_token_here

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

RENDER_API_KEY=your_render_api_key

UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

DATABASE_USERS=your_neon_users_database_url
DATABASE_PRODUCTS=your_neon_products_database_url
DATABASE_ANALYTICS=your_neon_analytics_database_url
DATABASE_FAILOVER=your_neon_failover_database_url

DATABASE_SUPABASE_BACKUP_API_KEY=your_supabase_key

R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ACCOUNT_ID=your_r2_account_id
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=trynex

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=Trynex_Bot

NODE_ENV=production
