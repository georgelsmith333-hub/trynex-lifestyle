# Treat all binary assets as binary — prevent LF/CRLF conversion and
# high-bit byte stripping that corrupts PNG/JPEG headers in text-mode
# transfers.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.svg  text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
*.zip   binary
*.glb   binary
*.gltf  text eol=lf
