# Cloudflare Pages SPA fallback.
# Static assets are served directly; all other routes fall through to index.html
# so that client-side routing (wouter) handles them correctly.
# The absence of dist/404.html ensures Cloudflare honours this rule with HTTP 200.
/assets/*  /assets/:splat  200
/api/*     /api/:splat     200
/*         /index.html     200
