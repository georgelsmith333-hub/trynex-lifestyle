# /api/* is handled by functions/api/[[route]].js (Cloudflare Pages Function).
# That file proxies all API calls to https://trynex-api.onrender.com — no
# redirect rule is needed here and _redirects cannot proxy to absolute URLs anyway.

# sitemap.xml and robots.txt are static files served directly from /public.
# Do NOT add proxy rules for these paths.

# SPA fallback is handled by dist/404.html (copied from index.html at build time).
# Cloudflare Pages automatically serves 404.html for all unmatched routes,
# which gives client-side routing the correct entry point on hard refresh.
# The old "/* /index.html 200" rule caused an infinite-loop warning and was
# silently ignored by CF Pages — so it has been removed.
