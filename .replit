modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "(PORT=8080 pnpm --filter @workspace/api-server run dev &) && PORT=5000 API_PORT=8080 pnpm --filter @workspace/trynex-storefront run dev"
waitForPort = 5000

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 3001

[[ports]]
localPort = 8084
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ALLOWED_ORIGINS = "https://5dbc2c72-08b1-41e9-9ac4-3a850eaaa07c-00-1b9rag63a79s6.pike.replit.dev,http://localhost:5000,http://localhost:5173"
NODE_ENV = "development"
PORT = "8080"

[userenv.development]
JWT_SECRET = "dev_jwt_secret_trynex_2024_change_in_prod"
ADMIN_JWT_SECRET = "dev_admin_jwt_secret_trynex_2024_change_in_prod"
