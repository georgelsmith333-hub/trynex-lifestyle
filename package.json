{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "esbuild": "0.28.1",
      "vite": "^7.3.6",
      "@babel/core": "^7.29.6",
      "postcss": "^8.5.18",
      "tar": "^7.5.21",
      "undici": "^6.27.0",
      "fast-uri": "^3.1.4",
      "linkify-it": "^5.0.2",
      "shell-quote": "^1.9.0",
      "qs": "^6.15.2",
      "markdown-it": "^14.2.0",
      "protobufjs": "^7.6.5",
      "body-parser": "^2.3.0",
      "js-yaml@3": "^3.15.0",
      "js-yaml@4": "^4.3.0",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@5": "^5.0.8",
      "uuid": "^11.1.1"
    },
    "onlyBuiltDependencies": ["sharp", "compression"]
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
