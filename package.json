{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "mockups:audit-sources": "python tools/audit_trynex_mockups.py",
    "mockups:prepare": "python tools/extract-photoreal-face-templates.py dist-mockups/staging/smart-v1/templates",
    "mockups:build": "node tools/build-smartobject-mockups.mjs",
    "mockups:audit-psd": "python tools/audit_psd_masters.py",
    "mockups:validate-matrix": "node tools/validate-smart-matrix.mjs",
    "validate:mockups": "node scripts/validate-mockup-matrix.mjs",
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "pnpm": {
    "patchedDependencies": {
      "metro@0.83.3": "patches/metro@0.83.3.patch",
      "metro@0.83.7": "patches/metro@0.83.7.patch"
    }
  },
  "devDependencies": {
    "ag-psd": "^31.0.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
